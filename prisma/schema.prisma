generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Seller {
  id             String   @id @default(uuid())
  storeName      String
  storeType      String
  email          String   @unique
  passwordHash   String
  phoneNumber    String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}